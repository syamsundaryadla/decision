rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the document belongs to the signed-in user
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Reports collection: Users can only read and write their own reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Users collection: Users can READ their own profile,
    // but can only UPDATE safe display fields (NOT credits, role, subscription, suspension).
    // The server (Firebase Admin SDK) bypasses these rules for privileged writes.
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      
      // Allow create only for initial profile setup
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.credits is number
        && request.resource.data.credits <= 5;
      
      // Allow update ONLY for safe display fields — block sensitive fields
      allow update: if isSignedIn() && isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['credits', 'role', 'isSuspended', 'subscriptionStatus']));
    }
    
    // Credit transactions: read-only for the owner, writes only via Admin SDK
    match /credit_transactions/{txId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only via Admin SDK
    }
    
    // Analytics, security logs, API logs: admin-only via Admin SDK
    match /analytics_daily/{docId} {
      allow read, write: if false;
    }
    
    match /security_logs/{logId} {
      allow read, write: if false;
    }
    
    match /api_logs/{logId} {
      allow read, write: if false;
    }
    
    // Default: deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
